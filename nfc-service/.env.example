# Local-only NFC write service. Copy to .env and adjust for the workstation.
PORT=8765
PUBLIC_BASE_URL=https://play.example.com
# NPC subdomain, used when the production page writes an NPC /staff/<token> tag.
NPC_BASE_URL=https://npc.example.com
# The production workstation origin. Add https://localhost:8443 for local mTLS.
ALLOWED_ORIGINS=https://production.example.com
# Optional: select one PC/SC reader by exact/partial name if several are attached.
READER_NAME=
CARD_TIMEOUT_MS=15000
# Only enable this for local HTTP development. Production NTAG URLs must be HTTPS.
ALLOW_HTTP_URL=false
