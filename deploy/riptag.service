[Unit]
Description=RIP TAG activity server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=riptag
Group=riptag
WorkingDirectory=/opt/riptag
EnvironmentFile=/opt/riptag/.env
Environment=PYTHONUNBUFFERED=1
# Exactly one worker is required: the SSE fan-out and the failed-code limiter
# are process-local, and SQLite is happiest with a single writer.
ExecStart=/opt/riptag/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --no-access-log \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=2
TimeoutStopSec=20
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
