# ---------------------------------------------------------------------------
# Development defaults. Copy to .env. APP_ENV=production rejects insecure
# defaults, so a development .env cannot silently become a production one.
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=撕名牌现场技术系统
PUBLIC_BASE_URL=http://127.0.0.1:8000
NPC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///data/activity.db

# Local HTTP development only. Production must be true (HTTPS + Secure cookie).
COOKIE_SECURE=false
SESSION_COOKIE_NAME=sm_session
SESSION_TTL_HOURS=168

# Console page: /console-<CONSOLE_SECRET>/
# Production workstation page: /production-<PRODUCTION_SECRET>/
# Both paths are mTLS-only in production.
CONSOLE_SECRET=local-console-secret
PRODUCTION_SECRET=local-production-secret

# Local development without Nginx: bypass the mTLS header checks.
# Never enable either flag in production.
ALLOW_INSECURE_CONSOLE=true
ALLOW_INSECURE_PRODUCTION=true

# Seed data becomes production_tasks; imported only when that table is empty.
# Keep false for the console setup wizard (ask group count / people per group).
SEED_CSV=data/seed.csv
SEED_ON_STARTUP=false

# Failed-code protection (per member, per process).
KILL_LOOKUP_LIMIT=30
KILL_LOOKUP_WINDOW_SECONDS=60
KILL_FAILURE_LIMIT=8
KILL_FAILURE_WINDOW_SECONDS=300
SSE_HEARTBEAT_SECONDS=15

# ---------------------------------------------------------------------------
# Production example (do not keep development values):
#
#   APP_ENV=production
#   PUBLIC_BASE_URL=https://play.example.com
#   NPC_BASE_URL=https://npc.example.com
#   COOKIE_SECURE=true
#   CONSOLE_SECRET=<random 32 chars>
#   PRODUCTION_SECRET=<another random 32 chars>
#   ALLOW_INSECURE_CONSOLE=false
#   ALLOW_INSECURE_PRODUCTION=false
#   DATABASE_URL=sqlite:////opt/riptag/data/activity.db
#
# Subdomains:
#   play.example.com        public players   (ssl_verify_client off)
#   npc.example.com         NPC field desk   (ssl_verify_client off)
#   console.example.com     technical console (ssl_verify_client on)
#   production.example.com  production API    (ssl_verify_client on)
#
# NTAG URLs use https://play.example.com/r/<ntag_token>.
# NPC tags use https://npc.example.com/staff/<npc_token>.
# The production tool is a separate subproject; it only consumes
# https://production.example.com/api/production/* with a client certificate.
# ---------------------------------------------------------------------------
